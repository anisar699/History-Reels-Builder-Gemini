# ==============================================================================
# AI Reels Studio - Environment Variables Configuration
# ==============================================================================
# Instructions: Copy this file, rename it to '.env', and input your API keys.
# DO NOT COMMIT THE ACTUAL '.env' FILE TO GITHUB! (It is ignored via .gitignore)
# ==============================================================================

# 1. OpenAI & Gemini API Keys (For script & query generation)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 2. Stock Media API Keys (For download of portraits clips)
PEXELS_API_KEY=your_pexels_api_key_here
PIXABAY_API_KEY=your_pixabay_api_key_here
STORYBLOCKS_PUBLIC_KEY=your_storyblocks_public_key_here
STORYBLOCKS_PRIVATE_KEY=your_storyblocks_private_key_here

# 3. Optional voice provider
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here
VOICE_PROVIDER=edge-tts

# 4. Fish Audio API Key (Optional - Only if using voice cloning scripts)
FISH_AUDIO_API_KEY=your_fish_audio_api_key_here

# 5. Public-hosting security (leave auth false for local desktop use)
DASHBOARD_REQUIRE_AUTH=false
DASHBOARD_PASSWORD_HASH=
DASHBOARD_ALLOW_SESSION_KEY_OVERRIDE=false

# 6. Worker mode: thread (default) or process (restart-recoverable queue)
JOB_WORKER_MODE=thread
