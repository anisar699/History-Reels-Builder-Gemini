# ==============================================================================
# History Reels Builder - Environment Variables Configuration
# ==============================================================================
# Instructions: Copy this file, rename it to '.env', and input your API keys.
# DO NOT COMMIT THE ACTUAL '.env' FILE TO GITHUB! (It is ignored via .gitignore)
# ==============================================================================

# 1. OpenAI API Key (For script & query generation)
OPENAI_API_KEY=your_openai_api_key_here

# 2. Stock Media API Keys (For download of portraits clips)
PEXELS_API_KEY=your_pexels_api_key_here
PIXABAY_API_KEY=your_pixabay_api_key_here

# 3. Fish Audio API Key (Optional - Only if using voice cloning scripts)
FISH_AUDIO_API_KEY=your_fish_audio_api_key_here
